{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/field": ["./src/shared/ui/field/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/shared/ui/utils/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/shared/ui/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/shared/ui/separator/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./src/shared/ui/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./src/shared/ui/input-group/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/shared/ui/button/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/shared/ui/input/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/shared/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/shared/ui/avatar/src/index.ts"],
      "@spartan-ng/helm/popover": ["./src/shared/ui/popover/src/index.ts"],
      "@spartan-ng/helm/hover-card": ["./src/shared/ui/hover-card/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./src/shared/ui/radio-group/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/shared/ui/select/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
